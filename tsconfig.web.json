{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "vitest/globals", "@testing-library/jest-dom"],
    "strict": true,
    "isolatedDeclarations": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "outDir": ".typecheck-temp/web",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/renderer/*"],
      "@logger": ["modules/logger/index.ts"],
      "@ui-kit": ["modules/ui-kit/index.ts"],
      "@data": ["modules/data/index.ts"],
      "@sources/shared": ["modules/sources/shared/index.ts"],
      "@test-utils": ["modules/test-utils/index.ts"],
      "@feed": ["modules/feed/index.ts"],
      "@tracker": ["modules/tracker/index.ts"],
      "@sources-page": ["modules/sources-page/index.ts"],
      "@settings": ["modules/settings/index.ts"],
      "@shell": ["modules/shell/index.ts"],
      "@app": ["modules/app/index.ts"]
    }
  },
  "include": [
    "src/renderer/**/*.ts",
    "src/renderer/**/*.tsx",
    "src/preload/electron-api.d.ts",
    "modules/**/*.ts",
    "modules/**/*.tsx"
  ],
  "exclude": [
    "modules/sources/main/**",
    "modules/persistence/main/**",
    "modules/logger/main.ts",
    "modules/test-utils/fixtures/**"
  ]
}
